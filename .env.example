# DiveCloud.net API & Session Automation Configuration
DIVECLOUD_API_URL=https://divecloud.net
DIVECLOUD_USERNAME=
DIVECLOUD_PASSWORD=
DIVECLOUD_TIMEOUT=45           # Timeout in seconds
DIVECLOUD_MAX_RETRIES=3        # Max retries on transient errors
DIVECLOUD_REQUEST_DELAY=1.0    # Delay between requests (seconds)

# Divelogs.org / Divelogs.de API Configuration (One-Way Sync Destination)
DIVELOGS_API_URL=https://divelogs.de/api
DIVELOGS_USERNAME=
DIVELOGS_PASSWORD=
DIVELOGS_BEARER_TOKEN=         # Optional: override bearer token directly

# Sync Settings
SYNC_DIRECTION=divecloud_to_divelog
DRY_RUN=false
LOG_LEVEL=INFO
